{
  "expo": {
    "name": "DailyMannaAI-Mobile",
    "slug": "DailyMannaAI-Mobile",
    "owner": "dailymannaai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dailymannaai.png",
    "scheme": "dailymannaaimobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailymannaai.DailyMannaAIMobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dailymannaai.DailyMannaAIMobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d4820f3-ac4c-476b-afd4-9f38a9d405df"
      }
    }
  }
}
